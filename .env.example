# Groq (free LLM API) — get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant — leave QDRANT_URL empty to use a local on-disk instance (no signup needed).
# To use a free Qdrant Cloud cluster instead, set QDRANT_URL and QDRANT_API_KEY.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=investor-intelligence
QDRANT_PATH=./qdrant_data

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=investor_intelligence
POSTGRES_USER=
POSTGRES_PASSWORD=
# "prefer" works for both local (no SSL) and hosted (SSL) Postgres. Use "require" for Azure/managed DBs that mandate SSL.
POSTGRES_SSLMODE=prefer
